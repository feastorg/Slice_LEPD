		(uuid "bf5a8107-5da2-49d6-aee5-93ae748552a5")
	)
	(text "FILTER CALCS\nStart by calculating equiv RC:\nThev. equiv of resistors Ra and Rb is:\nReff = Ra || Rb \n	 = (Ra*Rb) / (Ra+Rb)\n	 = (3300*1600) / (3300+1600)\n	 = 1077.55 = 1.78 Kohms\nCtot = Ca + Cb\n	 = 1.0u + 0.22u\n	 = 1.22uF\n\nCalculate Results:\nτ=Reff​*Ctot\n = 1.78 Kohms * 1.22uF\n = 2.17ms\nfc = 1 / (2*pi*τ)\n   = 1 / (2*pi*2.17)\n   = 73.3Hz"
		(exclude_from_sim no)
		(at 90.17 105.41 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "c016d9f2-3b20-4d1d-b645-67a8bc387a4a")
	)
