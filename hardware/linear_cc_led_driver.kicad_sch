	(text "I_LED = DAC_1 / RS\n\nI_LED_max = 100mA\nDAC_max_in = I_LED_max * RS = 1V\n\nPWM_max = 1V/1.63V *100% \n		= 61.34% = 60%\n\nPRS_max = I**2 * R \n		= 0.1*0.1*10\n		=0.1W"
		(exclude_from_sim no)
		(at 195.834 181.356 0)
		(effects
			(font
				(size 0.762 0.762)
				(thickness 0.2381)
			)
